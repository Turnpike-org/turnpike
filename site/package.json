{
  "name": "@turnpike/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "sync": "node scripts/sync-docs.mjs",
    "diagrams": "mmdc -i src/diagrams/lifecycle.mmd -o src/diagrams/lifecycle.svg -b transparent -c src/diagrams/theme.json && mmdc -i src/diagrams/system.mmd -o src/diagrams/system.svg -b transparent -c src/diagrams/theme.json"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "astro": "7.2.1",
    "geist": "1.7.2"
  },
  "devDependencies": {
    "hast-util-from-html": "^2.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  }
}
