# ─────────────────────────────────────────────────────────────────────────────
# x402 Stellar facilitator — example configuration
#
# Copy to `.env` and fill in, or run `npm run setup` to generate and fund
# testnet accounts via Friendbot and write this file for you.
#
# NEVER commit a real .env. Every key below is a TESTNET key; even so, .env is
# gitignored and stays that way.
# ─────────────────────────────────────────────────────────────────────────────

# ── Facilitator ──────────────────────────────────────────────────────────────
# Stellar secret key (S...) of the account that signs and submits settlement
# transactions AND pays their network fees. Must be a funded testnet account.
# Fund one at https://friendbot.stellar.org/?addr=<G...> or via `npm run setup`.
FACILITATOR_SECRET_KEY=S_YOUR_FACILITATOR_TESTNET_SECRET_HERE

# Port the facilitator listens on.
FACILITATOR_PORT=4022

# CAIP-2 network. This MVP supports `stellar:testnet` only; `stellar:pubnet` is
# out of scope and the service will refuse to start with it.
STELLAR_NETWORK=stellar:testnet

# Soroban RPC endpoint.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Safety ceiling, in stroops, on the simulation-derived transaction fee the
# facilitator is willing to pay. /verify rejects payments above it.
# 1 XLM = 10,000,000 stroops. Observed Soroban SAC transfer fees: ~20,000-60,000.
MAX_TRANSACTION_FEE_STROOPS=1000000

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Demo resource server ─────────────────────────────────────────────────────
# Port the demo resource server listens on.
DEMO_SERVER_PORT=4021

# Where the demo resource server reaches the facilitator. Inside docker compose
# this is http://facilitator:4022; on a host shell it is http://localhost:4022.
FACILITATOR_URL=http://localhost:4022

# Stellar address (G...) that receives the payment — the "seller".
SELLER_ADDRESS=G_YOUR_SELLER_TESTNET_ADDRESS_HERE

# Payment asset. One of:
#   native  — the native XLM Stellar Asset Contract (default; Friendbot-fundable,
#             so the whole demo reproduces with zero manual funding steps)
#   usdc    — testnet USDC SAC (CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA);
#             the payer account needs testnet USDC from https://faucet.circle.com/
#   C...    — any SEP-41 token contract address
PAYMENT_ASSET=native

# Price in atomic units of the asset above (Stellar assets use 7 decimals,
# so 100000 = 0.01 XLM).
PAYMENT_AMOUNT=100000

# ── Conformance harness (buyer) ──────────────────────────────────────────────
# Stellar secret key (S...) of the account that pays. Needs a balance of the
# asset above. `npm run setup` creates and funds it via Friendbot.
BUYER_SECRET_KEY=S_YOUR_BUYER_TESTNET_SECRET_HERE

# Base URL of the demo resource server the harness pays against.
DEMO_SERVER_URL=http://localhost:4021
